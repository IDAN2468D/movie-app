{
  "expo": {
    "name": "CineBook",
    "slug": "movie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "movie-app",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kazam11.cinebook"
    },
    "android": {
      "package": "com.kazam11.cinebook",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBEhKylM_JIAOG2UZvMOXp6xO6wMiccfVk"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-video",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "אפשר לסינבוק גישה למצלמה כדי לסרוק כרטיסים."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow CineBook to access your location to find nearby theaters."
        }
      ],
      "expo-sensors",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "reactNativeArchitectures": ["armeabi-v7a", "arm64-v8a"],
            "extraParams": {
              "org.gradle.jvmargs": "-Xmx2048m -XX:MaxMetaspaceSize=512m"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a13ea42-831e-46b4-ae33-fe4445b24c61"
      }
    },
    "owner": "kazam11"
  }
}
